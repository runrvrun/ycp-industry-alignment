# Local dev: plain file-based SQLite, used by `prisma migrate dev` and app runtime.
DATABASE_URL="file:./dev.db"

# Deployed environments (e.g. Vercel) have no persistent filesystem, so production
# uses a hosted libSQL database (Turso) instead. Set these in the hosting
# provider's environment variables — leave unset locally so dev keeps using the
# local SQLite file above.
# TURSO_DATABASE_URL="libsql://<db-name>-<org>.turso.io"
# TURSO_AUTH_TOKEN="..."
